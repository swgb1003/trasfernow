# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Local Firebase app identifiers (use the committed example as a template)
/config/firebase.local.json

# Firebase Admin SDK credentials must never be committed.
**/service-account*.json
/firebase/node_modules/
/firebase/.env
/firebase/.env.*
!/firebase/.env.example

# Licensed editorial images are uploaded to Firebase Storage, not Git.
/firebase/assets/players/*
!/firebase/assets/players/.gitkeep
/firebase/assets/club-crests/*
!/firebase/assets/club-crests/.gitkeep

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
